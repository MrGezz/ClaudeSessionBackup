<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ClaudeSessionBackup.App" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Declaring these is what lets the process see the
           real OS version and get per-monitor DPI v2 behaviour; without them
           Windows lies about the version and the shell falls back to bitmap
           scaling. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        PerMonitorV2, not "true" (system DPI). The window carries custom CM2
        chrome - its own title bar, traffic dots and theme toggle - and system
        DPI awareness makes that chrome render as a stretched bitmap the moment
        the window is dragged to a second monitor with a different scale factor.
        Bitmap-scaled custom chrome is the single most visible way a WPF app
        looks unfinished on a modern multi-monitor desk, which is exactly the
        setup a BIM coordinator has.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>

      <!-- UTF-8 process code page: job names and ACC paths carry non-ASCII
           (the live config already contains "DEAXO Sdn. Bhd-"), and the CLI
           writes those into logs. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          asInvoker, never requireAdministrator. Elevating would run the app in
          a DIFFERENT logon session from the interactive one, and ACC Desktop
          Connector only serves file downloads inside the user's own session -
          an elevated sync would find every cloud-only file unreadable and
          report success having copied nothing. The scheduled task is registered
          under the same principal for the same reason.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
