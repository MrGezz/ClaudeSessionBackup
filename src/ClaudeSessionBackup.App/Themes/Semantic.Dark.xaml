<!--
    HAND-WRITTEN, unlike Charcoal.xaml next to it (which is GENERATED and must
    not be edited). This app's own semantic keys in the CyanogenMod-2 dark
    palette: ok #4CAF50, warn #FFB300, danger #FF5252, violet #7C4DFF,
    accent #00BCD4, muted #5F7885. Every key here MUST also exist in
    Semantic.Light.xaml - a key defined in only one of the pair resolves to
    black in the other theme with no binding error.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- accent: rest / hover / 10% soft fill -->
    <SolidColorBrush x:Key="AppAccentBrush"      Color="#FF00BCD4" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF4DD0E1" />
    <SolidColorBrush x:Key="AppAccentSoftBrush"  Color="#1A00BCD4" />

    <!-- status tones: ink / 10% fill / 45% edge -->
    <SolidColorBrush x:Key="StatusOkBrush"       Color="#FF4CAF50" />
    <SolidColorBrush x:Key="StatusOkFill"        Color="#1A4CAF50" />
    <SolidColorBrush x:Key="StatusOkLine"        Color="#734CAF50" />

    <SolidColorBrush x:Key="StatusWarnBrush"     Color="#FFFFB300" />
    <SolidColorBrush x:Key="StatusWarnFill"      Color="#1AFFB300" />
    <SolidColorBrush x:Key="StatusWarnLine"      Color="#73FFB300" />

    <SolidColorBrush x:Key="StatusDangerBrush"   Color="#FFFF5252" />
    <SolidColorBrush x:Key="StatusDangerFill"    Color="#1AFF5252" />
    <SolidColorBrush x:Key="StatusDangerLine"    Color="#73FF5252" />

    <SolidColorBrush x:Key="StatusVioletBrush"   Color="#FF7C4DFF" />
    <SolidColorBrush x:Key="StatusVioletFill"    Color="#1A7C4DFF" />
    <SolidColorBrush x:Key="StatusVioletLine"    Color="#737C4DFF" />

    <SolidColorBrush x:Key="StatusMutedBrush"    Color="#FF5F7885" />
    <SolidColorBrush x:Key="StatusMutedFill"     Color="#1A5F7885" />
    <SolidColorBrush x:Key="StatusMutedLine"     Color="#735F7885" />

    <!-- surface hierarchy: window > nav > card > panel > panel2 -->
    <SolidColorBrush x:Key="WindowBrush"         Color="#FF0B1013" />
    <SolidColorBrush x:Key="NavBrush"            Color="#FF0F161A" />
    <SolidColorBrush x:Key="CardBrush"           Color="#FF141E24" />
    <SolidColorBrush x:Key="PanelBrush"          Color="#FF152026" />
    <SolidColorBrush x:Key="PanelBrush2"         Color="#FF1C2B33" />
    <SolidColorBrush x:Key="PanelLineBrush"      Color="#FF283B45" />

    <!-- code / log surface -->
    <SolidColorBrush x:Key="LogBackgroundBrush"  Color="#FF0F171C" />
    <SolidColorBrush x:Key="LogForegroundBrush"  Color="#FFB0C4CE" />

    <!-- text hierarchy -->
    <SolidColorBrush x:Key="TextMainBrush"       Color="#FFECF4F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#FF8FA6B2" />
    <SolidColorBrush x:Key="TextTertiaryBrush"   Color="#FF5F7885" />

    <!-- ================= site look (MrGezz.github.io grammar, 2026-09-27) =================
         Seven additive keys, referenced from the IcZ Patcher's theme layer rather than
         copied; each names the CSS rule it encodes. Colours are restated as literals
         because this file defines brushes only (accent #00BCD4, violet #7C4DFF).
           AccentGradientBrush          #progress - the cyan -> violet run, horizontal
           AccentGradientVerticalBrush  the same run vertical (the rail's checked bar)
           AccentBrandGradientBrush     .brand-mark - cyan -> #00838F diagonal, cyan-only
                                        ON PURPOSE so near-black ink on it stays above
                                        4.5:1 (near-black on violet measures 3.3:1)
           AppAccentInkBrush            the ink that sits ON the brand tile
           AppAccentEdgeBrush           .glass-card:hover border - accent at 45%
           GridLineBrush / GraphPaperBrush  #heroCanvas - a 6% grid as a 26px tile;
                                        lines sit at .5 so a 1px pen fills one device
                                        pixel inside its own tile
         Gradients are fills only: no text is ever set IN a gradient. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00BCD4" Offset="0" />
        <GradientStop Color="#FF7C4DFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF00BCD4" Offset="0" />
        <GradientStop Color="#FF7C4DFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF00BCD4" Offset="0" />
        <GradientStop Color="#FF00838F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppAccentInkBrush"   Color="#FF0B0E14" />
    <SolidColorBrush x:Key="AppAccentEdgeBrush"  Color="#7300BCD4" />
    <SolidColorBrush x:Key="GridLineBrush"       Color="#0F7FA0B4" />
    <DrawingBrush x:Key="GraphPaperBrush" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute"
                  Stretch="None" AlignmentX="Left" AlignmentY="Top">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0.5,0" EndPoint="0.5,26" />
                        <LineGeometry StartPoint="0,0.5" EndPoint="26,0.5" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource GridLineBrush}" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
