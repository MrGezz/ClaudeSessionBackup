<!--
    Shared converter instances and control styles, merged by the MainWindow.
    Every key here must remain in sync with what the pages reference as
    StaticResource. {StaticResource} resolves at LOAD time not compile time,
    so a missing key silently compiles clean and throws XamlParseException
    only when the page renders.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters">

    <!-- ======================== converter instances ======================== -->
    <conv:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter" />
    <conv:CountToVisibilityConverter  x:Key="CountToVisibilityConverter" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <conv:InverseBooleanConverter     x:Key="InverseBooleanConverter" />
    <conv:BytesToHumanConverter       x:Key="BytesToHumanConverter" />
    <conv:DurationConverter           x:Key="DurationConverter" />
    <conv:EnumToBoolConverter         x:Key="EnumToBoolConverter" />
    <conv:StoreStatusToBrushConverter x:Key="StoreStatusToBrushConverter" />
    <conv:EpochMsToDateConverter      x:Key="EpochMsToDateConverter" />
    <conv:NullToVisibilityConverter   x:Key="NullToVisibilityConverter" />

    <!-- The site grammar's kicker (2026-09-27): CSS text-transform:uppercase has
         no WPF property, so BOUND labels pass through this at their binding.
         Literal kickers are simply written in capitals. -->
    <conv:UpperCaseConverter          x:Key="Upper" />

    <!-- ============================== text ================================= -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Site look (MrGezz.github.io grammar, 2026-09-27), referenced from the IcZ
         Patcher's theme layer rather than copied: a card's key label is an 11px
         bold KICKER in capitals (.card .k), a headline figure is 26px bold in
         the main ink (.stat .n - plain ink on purpose, a gradient is a fill
         only), and the line under it is 11.5px secondary (.stat .d).
         Letter-spacing has no WPF property and is not mirrored. -->
    <Style x:Key="CardKeyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BandValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>

    <Style x:Key="BandDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ============================== surface ============================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Style.Triggers>
            <!-- .glass-card:hover: the border takes the accent edge under the
                 pointer. A Trigger, never a Storyboard; the site's lift and glow
                 are not mirrored. Every card in this style inherits it. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentEdgeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ glyph button ========================== -->
    <!--
        RULE: icon fonts (Segoe MDL2 Assets, Segoe Fluent Icons) must NEVER be
        set on a Button, Border or any container that also carries a ToolTip.
        Font properties inherit, so the ToolTip text renders in the glyph font
        and shows as squares. Set the FontFamily only on the inner TextBlock
        that displays the glyph. GlyphButtonStyle enforces this: the glyph
        TextBlock lives inside a ContentTemplate, so the Button's own font
        (inherited by the ToolTip) stays at the default UI family.
    -->
    <Style x:Key="GlyphButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- Content is expected to be the glyph character;
                             FontFamily goes here, never on the Button. -->
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ status pill ============================ -->
    <!--
        A rounded badge for store status and session flags. Triggers bind
        the relevant status property, and setters use DynamicResource so
        the pill follows theme toggles.
    -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource StatusMutedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusMutedLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusMutedBrush}" />
    </Style>

    <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
