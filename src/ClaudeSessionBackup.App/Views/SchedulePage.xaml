<UserControl x:Class="ClaudeSessionBackup.App.Views.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Schedule" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Windows Task Scheduler" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Register a daily backup task that runs the CLI headless. The task runs as the current user at the configured time."
                           Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,16" />

                <!-- Time -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Daily at (HH:mm):"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding TaskTime, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="21:00" />
                </Grid>

                <!-- At logon toggle -->
                <CheckBox Content="Also run at logon (3 min delay)"
                          IsChecked="{Binding TaskAtLogon}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Margin="0,0,0,16" />

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:Button Content="Install task" Appearance="Primary"
                               Command="{Binding InstallTaskCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Uninstall task"
                               Command="{Binding UninstallTaskCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Refresh status"
                               Command="{Binding RefreshTaskStatusCommand}" />
                </StackPanel>

                <!-- Status -->
                <TextBlock Text="{Binding TaskStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
