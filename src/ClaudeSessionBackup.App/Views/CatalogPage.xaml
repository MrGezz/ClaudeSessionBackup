<UserControl x:Class="ClaudeSessionBackup.App.Views.CatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters"
             xmlns:ctl="clr-namespace:ClaudeSessionBackup.App.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Session Catalog" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

        <!-- Search + Refresh -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search by title, project or session ID..."
                        Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" Content="Refresh"
                       Command="{Binding RefreshCatalogCommand}" />
        </Grid>

        <!-- Empty states. Before the first Refresh the grid renders as a bare
             header row over nothing, which reads as a broken page rather than
             as "no catalog yet" - so the grid is collapsed and one of these
             takes its place. CatalogSessions is the FILTERED collection, so an
             empty grid has two very different causes and gets two answers. -->

        <!-- Never built: offer the command that fixes it. -->
        <ctl:EmptyState Grid.Row="2"
                        Glyph="&#xE8F1;"
                        Title="No catalog yet"
                        Body="The catalog lists every session found in the live stores and in the backup. Build it once, then search it here and open any transcript."
                        Tone="Info"
                        VerticalAlignment="Top">
            <ctl:EmptyState.Style>
                <Style TargetType="ctl:EmptyState">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCatalog}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ctl:EmptyState.Style>
            <ctl:EmptyState.Actions>
                <ui:Button Content="Build catalog" Appearance="Primary"
                           Command="{Binding RefreshCatalogCommand}" />
            </ctl:EmptyState.Actions>
        </ctl:EmptyState>

        <!-- Built, but the search filtered everything out. -->
        <ctl:EmptyState Grid.Row="2"
                        Glyph="&#xE721;"
                        Title="No sessions match"
                        Body="Nothing in the catalog matches that search. Try part of a title, a project folder name, or a session ID."
                        Tone="Neutral"
                        VerticalAlignment="Top">
            <ctl:EmptyState.Style>
                <Style TargetType="ctl:EmptyState">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasCatalog}" Value="True" />
                                <Condition Binding="{Binding CatalogSessions.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ctl:EmptyState.Style>
        </ctl:EmptyState>

        <!-- Session grid -->
        <DataGrid Grid.Row="2"
                  x:Name="CatalogGrid"
                  Visibility="{Binding CatalogSessions.Count,
                      Converter={StaticResource CountToVisibilityConverter}}"
                  ItemsSource="{Binding CatalogSessions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource PanelBrush2}"
                  HorizontalGridLinesBrush="{DynamicResource PanelLineBrush}"
                  CanUserResizeRows="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  MouseDoubleClick="CatalogGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Last Activity" Width="130"
                    Binding="{Binding LastMs, Converter={StaticResource EpochMsToDateConverter}}" />
                <DataGridTextColumn Header="Project" Binding="{Binding ProjectDir}" Width="140" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Prompts" Binding="{Binding UserPrompts}" Width="65" />
                <DataGridTextColumn Header="Replies" Binding="{Binding AssistantMsgs}" Width="65" />
                <DataGridTextColumn Header="Size" Width="80"
                    Binding="{Binding Size, Converter={StaticResource BytesToHumanConverter}}" />
                <DataGridCheckBoxColumn Header="Live" Binding="{Binding TranscriptLive}" Width="50" />
                <DataGridCheckBoxColumn Header="Backup" Binding="{Binding TranscriptBackup}" Width="60" />
                <DataGridTextColumn Header="Sidebar" Binding="{Binding IndexSessionId}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" FontSize="11"
                                        Padding="4,1" Background="Transparent" BorderThickness="0"
                                        ToolTip="Open transcript viewer"
                                        Foreground="{DynamicResource AppAccentBrush}"
                                        Command="{Binding DataContext.OpenTranscriptCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding TranscriptRel,
                                            Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Icon font on the inner TextBlock only: setting it on the
                                 Button makes the ToolTip inherit the glyph font and render
                                 as squares. -->
                            <Button Padding="2" Background="Transparent" BorderThickness="0"
                                    ToolTip="Open transcript folder"
                                    Command="{Binding DataContext.OpenTranscriptFolderCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding TranscriptRel,
                                        Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
