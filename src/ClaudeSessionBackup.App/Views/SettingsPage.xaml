<UserControl x:Class="ClaudeSessionBackup.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Same shape as Sync-ACC's Settings page (user request 2026-09-06): one card per
         topic, a title, a bold label, a one-line hint, and a pill ToggleSwitch on the
         right for every yes/no choice. Scrollable, so a short window still reaches the
         last card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource WindowBrush}">
        <!-- Fills the content area, like every other page. It used to be
             MaxWidth="760" HorizontalAlignment="Left", which kept the form to a
             readable measure but left a 250 px gutter down the right and made
             Settings the only page whose cards did not reach the edge. -->
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

            <!-- ============================================================== -->
            <!-- Backup                                                          -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Backup" Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Text="Destination"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="A folder neither Claude app touches. One destination per machine keeps the run history apart."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" Content="Browse..."
                                   Command="{Binding BrowseDestinationCommand}" />
                    </Grid>

                    <!-- Include subagents -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Include subagent transcripts"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="The workflow scratch under each session's subagents folder (about 1.2 GB). Off keeps the backup small; on keeps every worker transcript too."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IncludeSubagents, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <!-- Keep snapshots -->
                    <TextBlock Text="Snapshots to keep"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Dated zips of the small stores. Older ones are moved to _to_delete, never deleted. 0 keeps them all."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ui:TextBox Width="120" HorizontalAlignment="Left"
                                Text="{Binding KeepSnapshots, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,12" />

                    <ui:Button Content="Save settings" Appearance="Primary"
                               Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- Appearance                                                      -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Dark theme"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Applied at once. Save settings keeps the choice for the next start."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- ToggleThemeCommand does the work (ThemeManager swaps the dictionaries);
                         IsChecked is one-way so the pill always reads the live IsDark value. -->
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding IsDark, Mode=OneWay}"
                                     Command="{Binding ToggleThemeCommand}"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- Window                                                          -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Window" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Minimise to the notification area"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Minimising hides the window and leaves an icon by the clock. Double-click it to come back, or right-click for Open and Exit. Scheduled runs do not need the app open either way."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Close to the notification area"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="The window's X hides it instead of quitting. Exit from the icon's menu quits; a running backup is finished first. Both switches apply at once and are kept by Save settings."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>