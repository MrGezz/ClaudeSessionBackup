<UserControl x:Class="ClaudeSessionBackup.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters"
             xmlns:model="clr-namespace:ClaudeSessionBackup.Core.Model;assembly=ClaudeSessionBackup.Core">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Dashboard" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

        <!-- Store table -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding StoreRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource PanelBrush2}"
                      HorizontalGridLinesBrush="{DynamicResource PanelLineBrush}"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Store name -->
                    <DataGridTextColumn Header="Store" Binding="{Binding Name}" Width="140" />

                    <!-- Description (wrapping) -->
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Live count + size -->
                    <DataGridTemplateColumn Header="Live" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LiveText}" TextAlignment="Right"
                                           HorizontalAlignment="Stretch" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Backup summary -->
                    <DataGridTemplateColumn Header="Backup" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BackupText}" TextAlignment="Right"
                                           HorizontalAlignment="Stretch" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status pill -->
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pill" Style="{StaticResource StatusPillStyle}">
                                    <TextBlock x:Name="PillText" Text="{Binding StatusText}"
                                               Style="{StaticResource StatusPillTextStyle}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Ok / Verified: green -->
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Ok}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusOkFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusOkLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Verified}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusOkFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusOkLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                    </DataTrigger>
                                    <!-- Failed / Error / SourceEmptyBackupHasData: red -->
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Failed}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Error}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceEmptyBackupHasData}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <!-- SourceMissing: optional stores show muted "absent"; non-optional show danger "missing" -->
                                    <!-- Non-optional missing: danger - something is wrong -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceMissing}" />
                                            <Condition Binding="{Binding Optional}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </MultiDataTrigger>
                                    <!-- Optional absent: muted (the StatusPillStyle default is already muted,
                                         but being explicit avoids depending on trigger evaluation order) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceMissing}" />
                                            <Condition Binding="{Binding Optional}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusMutedFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusMutedLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusMutedBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceEmpty}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusMutedFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusMutedLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusMutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Last run summary + task status -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding LastRunSummary}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScheduledTaskStatus}" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Store discovery warning: shown only when uncovered Claude data roots were found -->
        <Border Grid.Row="3"
                Background="{DynamicResource StatusWarnFill}"
                BorderBrush="{DynamicResource StatusWarnLine}"
                BorderThickness="1" CornerRadius="8"
                Padding="10,8" Margin="0,0,0,8"
                Visibility="{Binding HasUncoveredData, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding UncoveredDataText}"
                       Foreground="{DynamicResource StatusWarnBrush}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Action buttons -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PanelLineBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Backup now" Appearance="Primary"
                           Command="{Binding BackupCommand}"
                           IsEnabled="{Binding IsNotRunning}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Verify"
                           Command="{Binding VerifyCommand}"
                           IsEnabled="{Binding IsNotRunning}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Cancel"
                           Command="{Binding CancelCommand}"
                           IsEnabled="{Binding IsRunning}" />
            </StackPanel>
        </Border>

        <!-- Log pane: monospaced, scrollable -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}"
                Background="{DynamicResource LogBackgroundBrush}"
                Padding="8">
            <ListBox ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     x:Name="LogListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="12"
                                   Foreground="{DynamicResource LogForegroundBrush}"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
