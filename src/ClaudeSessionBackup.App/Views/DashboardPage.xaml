<UserControl x:Class="ClaudeSessionBackup.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ClaudeSessionBackup.App.Converters"
             xmlns:ctl="clr-namespace:ClaudeSessionBackup.App.Controls"
             xmlns:model="clr-namespace:ClaudeSessionBackup.Core.Model;assembly=ClaudeSessionBackup.Core">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <!-- The store table and the log share the window height (2:1) and each
             scrolls inside its card. With an Auto row the thirteen wrapped rows
             grew past the window and pushed the last-run card, the buttons and
             the log below the bottom edge with nothing to scroll. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Dashboard" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

        <!-- Metric row: the four numbers that answer "is my data safe", above
             the grid that says what happened store by store. Held back is 0 on
             a healthy run, and that is the point - any other value means the
             shrink guard stopped an overwrite and the log is worth reading. -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ctl:MetricCard Grid.Column="0" Margin="0,0,8,0"
                            Glyph="&#xE81E;"
                            Label="Stores backed up"
                            Value="{Binding MetricStoresValue}"
                            Detail="{Binding MetricStoresDetail}">
                <ctl:MetricCard.Style>
                    <Style TargetType="ctl:MetricCard">
                        <Setter Property="Tone" Value="Success" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MetricStoresAlert}" Value="True">
                                <Setter Property="Tone" Value="Danger" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:MetricCard.Style>
            </ctl:MetricCard>

            <ctl:MetricCard Grid.Column="1" Margin="4,0,4,0"
                            Glyph="&#xE8C8;"
                            Label="Files in backup"
                            Value="{Binding MetricFilesValue}"
                            Detail="{Binding MetricFilesDetail}"
                            Tone="Info" />

            <ctl:MetricCard Grid.Column="2" Margin="4,0,4,0"
                            Glyph="&#xEA35;"
                            Label="Backup size"
                            Value="{Binding MetricSizeValue}"
                            Detail="{Binding MetricSizeDetail}"
                            ToolTip="{Binding MetricSizeDetail}"
                            Tone="Info" />

            <ctl:MetricCard Grid.Column="3" Margin="8,0,0,0"
                            Glyph="&#xE7EF;"
                            Label="Held back"
                            Value="{Binding MetricHeldValue}"
                            Detail="{Binding MetricHeldDetail}">
                <ctl:MetricCard.Style>
                    <Style TargetType="ctl:MetricCard">
                        <Setter Property="Tone" Value="Neutral" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MetricHeldAlert}" Value="True">
                                <Setter Property="Tone" Value="Warning" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:MetricCard.Style>
            </ctl:MetricCard>
        </Grid>

        <!-- Store table -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding StoreRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource PanelBrush2}"
                      HorizontalGridLinesBrush="{DynamicResource PanelLineBrush}"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Store name -->
                    <!-- 160: "cowork3p-agent-mode" clipped at 140 -->
                    <DataGridTextColumn Header="Store" Binding="{Binding Name}" Width="160" />

                    <!-- Description (wrapping) -->
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Live count + size -->
                    <DataGridTemplateColumn Header="Live" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LiveText}" TextAlignment="Right"
                                           HorizontalAlignment="Stretch" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Backup summary -->
                    <!-- 195: "+493 copied, 13,430 same" clipped at 170 -->
                    <DataGridTemplateColumn Header="Backup" Width="195">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BackupText}" TextAlignment="Right"
                                           HorizontalAlignment="Stretch" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status pill -->
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pill" Style="{StaticResource StatusPillStyle}">
                                    <TextBlock x:Name="PillText" Text="{Binding StatusText}"
                                               Style="{StaticResource StatusPillTextStyle}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Ok / Verified: green -->
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Ok}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusOkFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusOkLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Verified}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusOkFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusOkLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                    </DataTrigger>
                                    <!-- Failed / Error / SourceEmptyBackupHasData: red -->
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Failed}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.Error}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceEmptyBackupHasData}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </DataTrigger>
                                    <!-- SourceMissing: optional stores show muted "absent"; non-optional show danger "missing" -->
                                    <!-- Non-optional missing: danger - something is wrong -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceMissing}" />
                                            <Condition Binding="{Binding Optional}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusDangerFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                    </MultiDataTrigger>
                                    <!-- Optional absent: muted (the StatusPillStyle default is already muted,
                                         but being explicit avoids depending on trigger evaluation order) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceMissing}" />
                                            <Condition Binding="{Binding Optional}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusMutedFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusMutedLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusMutedBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static model:StoreStatus.SourceEmpty}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusMutedFill}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource StatusMutedLine}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusMutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Last run summary + task status -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding LastRunSummary}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScheduledTaskStatus}" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Warnings, each shown only when it has something to say -->
        <StackPanel Grid.Row="4">
            <!-- Store discovery: uncovered Claude data roots were found -->
            <Border Background="{DynamicResource StatusWarnFill}"
                    BorderBrush="{DynamicResource StatusWarnLine}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding HasUncoveredData, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding UncoveredDataText}"
                           Foreground="{DynamicResource StatusWarnBrush}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
            </Border>
            <!-- Scheduled task: its exe is missing or its last run failed. Task Scheduler
                 shows "Ready" in both cases, so without this card a broken daily backup
                 looks healthy (it did, 2026-09-05 22:05 to 2026-09-06). -->
            <Border Background="{DynamicResource StatusWarnFill}"
                    BorderBrush="{DynamicResource StatusWarnLine}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding HasTaskWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding TaskWarningText}"
                           Foreground="{DynamicResource StatusWarnBrush}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <!-- Action buttons -->
        <Border Grid.Row="5"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PanelLineBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Backup now" Appearance="Primary"
                           Command="{Binding BackupCommand}"
                           IsEnabled="{Binding IsNotRunning}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Verify"
                           Command="{Binding VerifyCommand}"
                           IsEnabled="{Binding IsNotRunning}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Cancel"
                           Command="{Binding CancelCommand}"
                           IsEnabled="{Binding IsRunning}" />
            </StackPanel>
        </Border>

        <!-- Log pane: monospaced, scrollable -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}"
                Background="{DynamicResource LogBackgroundBrush}"
                Padding="8">
            <ListBox ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     x:Name="LogListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="12"
                                   Foreground="{DynamicResource LogForegroundBrush}"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
