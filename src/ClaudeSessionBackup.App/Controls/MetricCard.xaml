<UserControl x:Class="ClaudeSessionBackup.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClaudeSessionBackup.App.Controls">
    <!--
        One headline number: a tinted glyph tile beside a label, the value, and a
        line of detail underneath. Four of these sit across the top of the
        Dashboard.

        Same shape as EmptyState and for the same reason - a UserControl with an
        inline ControlTemplate, because Style.Triggers cannot use TargetName and
        the tone has to retarget the tile and the glyph together.

        The value is the only large type on the card. Detail is trimmed rather
        than wrapped: these sit in a fixed four-column grid, and a card that grows
        a second line makes the row ragged.
    -->
    <UserControl.Template>
        <ControlTemplate TargetType="ctl:MetricCard">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource PanelLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Glyph tile. The icon FontFamily is on the TextBlock only,
                         never on the Border: it would inherit into any ToolTip
                         and render there as squares. -->
                    <Border x:Name="Tile"
                            Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="8"
                            BorderThickness="1"
                            Background="{DynamicResource StatusMutedFill}"
                            BorderBrush="{DynamicResource StatusMutedLine}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="Glyph"
                                   Text="{TemplateBinding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource StatusMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Label}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{TemplateBinding Value}"
                                   FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMainBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                        <TextBlock Text="{TemplateBinding Detail}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="Tone" Value="Info">
                    <Setter TargetName="Tile"  Property="Background" Value="{DynamicResource StatusVioletFill}" />
                    <Setter TargetName="Tile"  Property="BorderBrush" Value="{DynamicResource StatusVioletLine}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource StatusVioletBrush}" />
                </Trigger>
                <Trigger Property="Tone" Value="Success">
                    <Setter TargetName="Tile"  Property="Background" Value="{DynamicResource StatusOkFill}" />
                    <Setter TargetName="Tile"  Property="BorderBrush" Value="{DynamicResource StatusOkLine}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                </Trigger>
                <Trigger Property="Tone" Value="Warning">
                    <Setter TargetName="Tile"  Property="Background" Value="{DynamicResource StatusWarnFill}" />
                    <Setter TargetName="Tile"  Property="BorderBrush" Value="{DynamicResource StatusWarnLine}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                </Trigger>
                <Trigger Property="Tone" Value="Danger">
                    <Setter TargetName="Tile"  Property="Background" Value="{DynamicResource StatusDangerFill}" />
                    <Setter TargetName="Tile"  Property="BorderBrush" Value="{DynamicResource StatusDangerLine}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
